uniform shader backdrop;

uniform float4 shape0;
uniform float2 corner0;
uniform float4 shape1;
uniform float2 corner1;
uniform float smoothing;

uniform float bezelWidth;
uniform float thickness;
uniform float glassIor;
uniform float displacementFactor;
uniform float dispersion;
uniform float morphDispersion;
uniform float progress;
uniform float4 tint;
uniform float legibility;

uniform float2 lightDir;
uniform float4 specular;
uniform float2 specularShape;

uniform float3 stroke;
uniform float4 shadow;
uniform float shadowAlpha;
uniform float opacity;
uniform float blackFade;
uniform float rimReach;
uniform float4 lingosoul;
uniform float4 lingosoulWave;

const float kEpsilon = 0.0001;
const float kUnionDepth = 0.25;
const float kMaxSlope = 11.430052;
const float kEdgeOffset = 0.7;
const float kEdgeSoftness = 0.6;
const float kEdgeReach = 1.0;

float roundRect(float2 p, float4 s, float2 c, out float2 g) {
    float2 sgn = float2(p.x < s.x ? -1.0 : 1.0, p.y < s.y ? -1.0 : 1.0);
    float2 q = abs(p - s.xy) - s.zw + c.x;
    if (q.x > 0.0 && q.y > 0.0) {
        float2 m = q / c.x;
        float2 mp = pow(m, float2(c.y - 1.0));
        g = normalize(mp) * sgn;
        return (pow(mp.x * m.x + mp.y * m.y, 1.0 / c.y) - 1.0) * c.x;
    }
    g = q.x > q.y ? float2(sgn.x, 0.0) : float2(0.0, sgn.y);
    return max(q.x, q.y) - c.x;
}

float scene(float2 p, out float2 g) {
    float2 g0;
    float d0 = roundRect(p, shape0, corner0, g0);
    if (lingosoul.w > 0.0) {
        float2 halfSize = max(shape0.zw, float2(1.0));
        float2 local = (p - shape0.xy) / halfSize;
        float2 q = abs(local);
        float power = 2.4;
        float radial = pow(pow(q.x, power) + pow(q.y, power), 1.0 / power);
        float2 derivative = pow(q, float2(power - 1.0)) / halfSize;
        float magnitude = length(derivative);
        float oval = magnitude > kEpsilon
            ? (radial - 1.0) * pow(radial, power - 1.0) / magnitude
            : -min(halfSize.x, halfSize.y);
        float2 ovalGradient = magnitude > kEpsilon
            ? derivative * sign(local) / magnitude : g0;
        d0 = mix(d0, oval, lingosoul.w);
        g0 = normalize(mix(g0, ovalGradient, lingosoul.w));
    }
    if (shape1.z <= 0.0) {
        g = g0;
        return d0;
    }
    float2 g1;
    float d1 = roundRect(p, shape1, corner1, g1);
    float h = smoothing > kEpsilon ? clamp(1.0 - abs(d0 - d1) / smoothing, 0.0, 1.0) : 0.0;
    if (h <= kEpsilon) {
        g = d0 <= d1 ? g0 : g1;
        return min(d0, d1);
    }
    float w = clamp(2.0 * kUnionDepth * h, 0.0, 1.0);
    float left = d0 <= d1 ? 1.0 - w : w;
    float2 blended = g0 * left + g1 * (1.0 - left);
    float len = length(blended);
    g = len > kEpsilon ? blended / len : float2(0.0, -1.0);
    return min(d0, d1) - smoothing * kUnionDepth * h * h;
}

float3 background(float2 c) {
    return float3(backdrop.eval(c).rgb);
}

float2 lingosoulFloor(float2 p, float d, float2 g) {
    float height = max(shape0.w * 2.0, 1.0);
    float lower = smoothstep(-0.3, 0.45, g.y);
    float contour = exp(-pow((d - 0.7) / 0.9, 2.0)) * 0.24 * lower;
    float nx = (p.x - shape0.x) / max(shape0.z * 1.7, 1.0) + 0.5;
    float spindle = pow(max(sin(clamp(nx, 0.0, 1.0) * 3.14159265), 0.0), 2.2);
    float energy = smoothstep(0.015, 0.6, lingosoul.z);
    float pulse = 1.0 + 0.12 * sin(lingosoulWave.y * 1.5);
    float depth = max(d - 1.6, 0.0) / (height * (0.07 + 0.03 * energy));
    float caustic = spindle * smoothstep(0.8, 2.2, d) * exp(-depth * depth)
        * smoothstep(0.2, 0.7, g.y) * lingosoul.x * (0.7 + 0.3 * energy) * pulse;
    return float2(contour, clamp(caustic, 0.0, 1.0));
}

float underlay(float2 p, float d, float2 g, float coverage) {
    float strokeA = 0.0;
    if (stroke.y > 0.0) {
        float outset = max(stroke.x * g.x * g.x + stroke.z * max(g.y, 0.0), 0.0);
        strokeA = clamp((1.0 - smoothstep(outset - 0.5, outset + 0.5, d)) * smoothstep(-0.5, 0.5, d), 0.0, 1.0)
            * stroke.y * coverage;
    }
    float shadowA = 0.0;
    if (shadowAlpha > 0.0) {
        float2 unused;
        float ds = scene(p - shadow.xy, unused) - shadow.w;
        float r = max(shadow.z, 0.5);
        shadowA = (1.0 - smoothstep(-r, r, ds)) * shadowAlpha * coverage;
        if (lingosoul.w > 0.0) {
            shadowA = min(shadowA + lingosoulFloor(p, d, g).x * coverage * lingosoul.w, 1.0);
        }
    }
    return strokeA + shadowA * (1.0 - strokeA);
}

// LingoSoul glass and spindle waves ported from https://github.com/neeldedkawala/ios-siri-animation
// Copyright (c) 2026 Neel Dedkawala. MIT license: ../licenses/ios-siri-animation-LICENSE.
const float kLingoSoulUnitWidth = 53.0;
const float kLingoSoulBezel = 58.0;
const float kLingoSoulThickness = 31.0;
const float kLingoSoulIor = 3.05;
const float kLingoSoulDispersion = 2.0;
const float kLingoSoulCurvature = 8.0;
const float kLingoSoulScaleRatio = 3.8;
const float kLingoSoulRimWidth = 1.4;
const float kLingoSoulRimIntensity = 0.97;
const float kLingoSoulWaveRefract = 6.3;
const float kLingoSoulWaveDispersion = 15.0;
const float kLingoSoulWaveEdgeBand = 4.5;
const float kLingoSoulWavePower = 1.55;
const float kLingoSoulLineThickness = 0.056;
const float kLingoSoulSpindleWidth = 2.3;
const float kLingoSoulPinTaper = 2.8;
const float kLingoSoulYScale = 0.11;
const float kLingoSoulXScale = 1.6;
const float kLingoSoulGlowFalloff = 1.5;
const float kLingoSoulGlowIntensity = 1.15;
const float kLingoSoulEdgeFade = 0.42;
const float kLingoSoulHotCoreThreshold = 7.2;
const float kLingoSoulHotCoreIntensity = 3.2;
const float kLingoSoulPhaseDistance = -4.1;
const float kLingoSoulIntroStartAmp = 0.2;

float lingosoulSnell(float d, float bezel, float thickness, float n, out float height) {
    if (d >= bezel || d <= 0.0) {
        height = d <= 0.0 ? 0.0 : thickness;
        return 0.0;
    }
    float u = clamp(d / max(bezel, 1.0), 0.0, 1.0);
    float innerArc = clamp(1.0 - pow(1.0 - u, kLingoSoulCurvature), 0.0, 1.0);
    height = thickness * sqrt(innerArc);
    float denom = max(sqrt(innerArc), 0.05);
    float slope = (thickness / max(bezel, 1.0)) * (pow(1.0 - u, kLingoSoulCurvature - 1.0) / denom);
    float theta1 = atan(slope);
    float theta2 = asin(clamp(sin(theta1) / max(n, 1.001), -0.999, 0.999));
    return height * tan(theta1 - theta2);
}

float3 lingosoulWaves(float2 local, float2 normal, float inward, float unit) {
    float fade = lingosoul.x;
    if (fade <= 0.001) {
        return float3(0.0);
    }
    float progress = lingosoul.w;
    float time = lingosoulWave.y;
    float intro = lingosoulWave.x;
    float energy = smoothstep(0.015, 0.6, lingosoul.z);
    float edgeZone = clamp(1.0 - inward / max(kLingoSoulWaveEdgeBand * unit, 1.0), 0.0, 1.0);
    float edgeMask = pow(edgeZone, kLingoSoulWavePower);
    float3 accum = float3(0.0);
    float density = 0.0;
    float crossings = 0.0;
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float ampWeight = i == 0 ? 1.30 : i == 1 ? 0.70 : i == 2 ? 1.22 : 0.72;
        float thickWeight = i == 0 ? 1.35 : i == 1 ? 0.72 : i == 2 ? 1.30 : 0.75;
        float phaseWeight = i == 0 ? 0.0 : i == 1 ? 0.38 : i == 2 ? 0.75 : 1.15;
        float start = fi / 3.0 * 0.42;
        float raw = clamp((intro - start) / 0.58, 0.0, 1.0);
        float waveProgress = raw * raw * (3.0 - 2.0 * raw);
        float dispersionOffset = (fi - 1.5) * (kLingoSoulWaveDispersion * 0.25);
        float displacement = edgeZone * kLingoSoulWaveRefract * 4.0 + dispersionOffset * edgeMask;
        float2 shifted = local - normal * (displacement * edgeMask * progress * unit);
        float2 wp = float2(shifted.x, shifted.y + 0.5 * progress * unit) / (kLingoSoulUnitWidth * unit);
        float nx = wp.x / kLingoSoulSpindleWidth + 0.5;
        if (nx > 0.0 && nx < 1.0) {
            float envelope = pow(sin(nx * 3.14159265), kLingoSoulPinTaper);
            float fadeMask = smoothstep(0.0, kLingoSoulEdgeFade, nx) * smoothstep(1.0, 1.0 - kLingoSoulEdgeFade, nx);
            float harmonic = 1.0 + 0.12 * sin(time * 1.5 + fi * 1.3);
            float goal = ampWeight * harmonic * mix(0.55, 1.0, energy);
            float amp = mix(kLingoSoulIntroStartAmp, goal, waveProgress) * kLingoSoulYScale * envelope;
            float phase = kLingoSoulPhaseDistance * phaseWeight * waveProgress;
            float waveY = sin(wp.x * kLingoSoulXScale + time + phase) * amp;
            float dist = abs(wp.y + waveY);
            float thick = kLingoSoulLineThickness * envelope * mix(1.0, thickWeight, waveProgress);
            float w = pow(clamp(thick / (dist + thick * 0.32), 0.0, 1.0), kLingoSoulGlowFalloff);
            float lineOffset = wp.y + waveY + (fi - 1.5) * thick * 0.75 * envelope - 0.14 * shape0.w / (kLingoSoulUnitWidth * unit);
            float soft = thick * 2.6;
            float patch = 0.3 + 0.7 * smoothstep(-0.2, 0.9, sin(wp.x * 2.1 - time * 0.3 + fi * 1.9));
            float prism = smoothstep(0.55, 0.95, sin(wp.x * 2.1 - time * 0.3 + fi * 1.9));
            float split = soft * (0.24 * patch + 0.55 * prism);
            float red = exp(-pow((lineOffset + split * (0.15 + 0.45 * prism)) / soft, 2.0));
            float green = exp(-pow((lineOffset - split * 0.35) / soft, 2.0));
            float blue = exp(-pow((lineOffset - split * 1.2) / soft, 2.0));
            float core = exp(-pow(lineOffset / max(thick * 0.35, 1e-4), 2.0));
            float halo = exp(-abs(lineOffset) / max(thick * 2.6, 1e-4));
            float3 color = float3(red, green * 0.98, blue * 0.95) * 0.18
                + float3(core) * 0.05
                + float3(1.0, 0.97, 0.92) * halo * 0.085;
            accum += color * fadeMask;
            density += w * fadeMask;
            crossings += smoothstep(thick * 2.2, 0.0, dist);
        }
    }
    if (density > kLingoSoulHotCoreThreshold && crossings >= 2.6) {
        float white = smoothstep(kLingoSoulHotCoreThreshold, kLingoSoulHotCoreThreshold + 3.0, density);
        accum = mix(accum, float3(kLingoSoulHotCoreIntensity), white * 0.85);
    }
    return accum * kLingoSoulGlowIntensity * fade;
}

float3 lingosoulBody(float2 p, float inward, float2 g) {
    float progress = lingosoul.w;
    float unit = max(shape0.z, 1.0) / kLingoSoulUnitWidth;
    float2 local = p - shape0.xy;
    float halfHeight = max(shape0.w, 1.0);
    float dispersion = kLingoSoulDispersion * 0.15;
    float height;
    float bezel = kLingoSoulBezel * unit;
    float thickness = kLingoSoulThickness * unit;
    float shiftR = lingosoulSnell(inward, bezel, thickness, kLingoSoulIor - dispersion * 0.04, height);
    float shiftG = lingosoulSnell(inward, bezel, thickness, kLingoSoulIor, height);
    float shiftB = lingosoulSnell(inward, bezel, thickness, kLingoSoulIor + dispersion * 0.07, height);
    float scale = kLingoSoulScaleRatio * progress;
    float3 refracted = float3(
        background(p - g * shiftR * scale).r,
        background(p - g * shiftG * scale).g,
        background(p - g * shiftB * scale).b);
    float yRatio = clamp((local.y + halfHeight * 0.15) / (halfHeight * 1.15), 0.0, 1.0);
    float translucency = smoothstep(0.18, 0.92, yRatio) * progress;
    float3 body = mix(float3(0.0), refracted, translucency);
    body += lingosoulWaves(local, g, inward, unit);
    float bottomFactor = clamp((local.y + halfHeight * 0.25) / (halfHeight * 1.25), 0.0, 1.0);
    float rim = smoothstep(max(kLingoSoulRimWidth * unit, 0.1), 0.0, inward) * bottomFactor * progress;
    float behind = dot(refracted, float3(0.2126, 0.7152, 0.0722));
    body += float3(0.96, 0.98, 1.0) * rim * kLingoSoulRimIntensity * 0.7 * mix(0.3, 1.0, smoothstep(0.15, 0.7, behind));
    return clamp(body, 0.0, 1.0);
}

half4 shade(float2 p, float d, float2 g, float t, float pulse, float coverage) {
    float softness = mix(kEdgeSoftness, max(1.0, shape0.w * 0.018), lingosoul.w);
    float fill = 1.0 - smoothstep(kEdgeOffset - softness, kEdgeOffset + softness, d);
    float under = fill < 1.0 ? underlay(p, d, g, coverage) : 0.0;
    if (fill <= 0.0) {
        if (lingosoul.w > 0.0) {
            float floorLuma = dot(background(p), float3(0.2126, 0.7152, 0.0722));
            float light = lingosoulFloor(p, d, g).y * lingosoul.w * coverage * 0.5 * smoothstep(0.2, 0.75, floorLuma);
            return half4(half3(float3(1.0, 0.97, 0.9) * light * opacity), half((light + under * (1.0 - light)) * opacity));
        }
        return half4(0.0, 0.0, 0.0, half(under * opacity));
    }

    float inward = max(-d, 0.0);
    float band = clamp(inward / max(bezelWidth, 1.0), 0.0, 1.0);
    float u = 1.0 - band;
    float u2 = u * u;
    float slope = inward <= bezelWidth
        ? min(2.0 * u2 * u / sqrt(max(1.0 - u2 * u2, kEpsilon)), kMaxSlope)
        : 0.0;
    float3 normal = normalize(float3(g * slope, 1.0));

    float3 ray = refract(float3(0.0, 0.0, -1.0), normal, 1.0 / max(glassIor, 1.0001));
    float2 shift = ray.z < 0.0
        ? ray.xy / -ray.z * (thickness + inward * 0.5) * displacementFactor
        : float2(0.0);
    shift *= t + 7.0 * t * (1.0 - t);

    float spread = dispersion + morphDispersion * pulse;
    float3 glass;
    if (dot(shift, shift) < 0.0025) {
        glass = background(p);
    } else if (spread < 0.001) {
        glass = background(p + shift);
    } else {
        glass = float3(
            background(p + shift * (1.0 + spread)).r,
            background(p + shift).g,
            background(p + shift * (1.0 - spread)).b);
    }
    float luma = dot(glass, float3(0.2126, 0.7152, 0.0722));
    float tintAmount = min(tint.a + legibility * smoothstep(0.35, 0.95, luma), 1.0);
    glass = mix(glass, tint.rgb, tintAmount * coverage);
    if (blackFade > 0.0) {
        float top = shape0.y - shape0.w;
        float height = clamp((p.y - top) / max(shape0.w * 2.0, 1.0), 0.0, 1.0);
        float black = 1.0 - smoothstep(0.15, 0.85, height);
        glass = mix(glass, float3(0.0), blackFade * black);
    }
    if (lingosoul.w > 0.0) {
        glass = mix(glass, lingosoulBody(p, inward, g), lingosoul.w);
    }
    float rim = 1.0 - smoothstep(0.0, max(specularShape.x, 0.25), abs(d));
    if (rim > 0.0) {
        float falloff = specular.w * band * band;
        float lit = pow(max(dot(g, lightDir), 0.0), specularShape.y) * max(specular.x - falloff, 0.0);
        float opposite = pow(max(dot(g, -lightDir), 0.0), specularShape.y) * max(specular.y - falloff, 0.0);
        glass += clamp((lit + opposite) * rim, 0.0, 1.0) * specular.z * min(coverage + pulse * 0.85, 1.75);
    }

    float alpha = fill + under * (1.0 - fill);
    return half4(half3(glass * fill * opacity), half(alpha * opacity));
}

half4 main(float2 p) {
    float t = clamp(progress, 0.0, 1.0);
    if (t <= 0.0) {
        return half4(0.0);
    }
    float pulse = 4.0 * t * (1.0 - t);
    float coverage = smoothstep(0.0, 0.55, t);

    float2 g;
    float d = scene(p, g);
    float outer = max(stroke.x + stroke.z, kEdgeOffset + kEdgeSoftness) + kEdgeReach;
    bool edge = d >= -rimReach && d <= outer;
    float samples = edge ? 4.0 : 1.0;
    float2 offset = edge ? float2(0.125, 0.375) : float2(0.0);
    half4 sum = half4(0.0);
    for (int i = 0; i < 4; i++) {
        if (float(i) >= samples) {
            break;
        }
        float2 q = p + offset;
        float dq = d;
        if (edge) {
            dq = scene(q, g);
        }
        sum += shade(q, dq, g, t, pulse, coverage);
        offset = float2(-offset.y, offset.x);
    }
    return sum / half(samples);
}
